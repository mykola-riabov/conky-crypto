# Copy to ~/.config/conky-crypto/env (absolute paths only).
#
#   mkdir -p ~/.config/conky-crypto
#   cp systemd/conky-crypto.env.example ~/.config/conky-crypto/env

CONKY_REPO=/path/to/conky-crypto
DISPLAY=:0

# Optional overrides for scripts/osmosis-price.sh
# OSMOSIS_API_URL=https://public-osmosis-api.numia.xyz/tokens/v2/all
# OSMOSIS_CACHE_MAX_AGE=60
